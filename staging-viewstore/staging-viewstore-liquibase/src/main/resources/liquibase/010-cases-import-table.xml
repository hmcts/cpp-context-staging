<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.3.xsd">

    <changeSet id="9" author="Staging">

        <createTable tableName="cases_import">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="filename" type="TEXT"/>
            <column name="status" type="TEXT"/>
            <column name="time_stamp" type="DATETIME"/>
            <column name="cases_count" type="NUMBER"/>
            <column name="processed_count" type="NUMBER"/>
            <column name="error_count" type="NUMBER"/>
        </createTable>

        <createIndex indexName="idx_cases_import_time_stamp"
                     tableName="cases_import"
                     unique="true">
            <column name="time_stamp" type="DATETIME"/>
        </createIndex>

        <createTable tableName="cases_import_file">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="filename" type="TEXT"/>
            <column name="cases_import_id" type="UUID"/>
            <column name="error_count" type="NUMBER"/>
        </createTable>

        <createTable tableName = "cases_import_file_error_message">
            <column name = "id" type = "UUID">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name = "message_key" type = "TEXT"/>
            <column name = "cases_import_file_id" type = "UUID"/>
        </createTable>

        <createTable tableName = "cases_import_file_error_message_param">
            <column name = "id" type = "UUID">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name = "cases_import_file_error_message_id" type = "UUID"/>
            <column name = "param_name" type = "TEXT">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name = "param_value" type = "TEXT"/>
        </createTable>

    </changeSet>

</databaseChangeLog>
