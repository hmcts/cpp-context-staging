<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.3.xsd">

    <changeSet id="8" author="Staging">

        <createTable tableName="batch_processing_status">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="filename" type="TEXT"/>
            <column name="status" type="TEXT"/>
            <column name="time_stamp" type="DATETIME"/>
            <column name="file_count" type="NUMBER"/>
            <column name="error_count" type="NUMBER"/>
            <column name="processed_count" type="NUMBER"/>
        </createTable>

        <addColumn tableName="file_processing_status">
            <column name="batch_processing_status_id" type="UUID"/>
        </addColumn>
        <addColumn tableName="file_processing_status">
            <column name="document_type" type="TEXT"/>
        </addColumn>

        <createIndex indexName="idx_batch_processing_status_time_stamp"
                     tableName="batch_processing_status"
                     unique="true">
            <column name="time_stamp" type="DATETIME"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
