package uk.gov.justice.api.resource.identity.accesscontrol;

import uk.gov.moj.cpp.accesscontrol.drools.Outcome;
import uk.gov.moj.cpp.accesscontrol.drools.Action;
import java.util.Arrays;

rule "Command - Rule for Recording IDAM Command"
  when
    $outcome: Outcome();
    $action: Action(name == "staging.record-idam-command");
    
  then
    $outcome.setSuccess(true);
end