#%RAML 0.8
title: API Using media type in the URL
baseUri: message://event/processor/message/staging

/staging.processor.event:
    post:
      body:
        application/vnd.identity.events.account-created+json:
           schema: !include json/schema/identity.events.account-created.json
           example: !include json/identity.events.account-created.json
        application/vnd.identity.events.account-updated+json:
           schema: !include json/schema/identity.events.account-updated.json
           example: !include json/identity.events.account-updated.json
