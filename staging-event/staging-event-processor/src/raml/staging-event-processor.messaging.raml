        application/vnd.identity.events.account-suspension-updated+json:
           schema: !include json/schema/identity.events.account-suspension-updated.json
           example: !include json/identity.events.account-suspension-updated.json
        application/vnd.identity.events.account-deregistered+json:
           schema: !include json/schema/identity.events.account-deregistered.json
           example: !include json/identity.events.account-deregistered.json
        application/vnd.identity.events.account-reregistered+json:
           schema: !include json/schema/identity.events.account-reregistered.json
           example: !include json/identity.events.account-reregistered.json
        application/vnd.identity.events.account-deleted+json:
           schema: !include json/schema/identity.events.account-deleted.json
