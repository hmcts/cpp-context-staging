        application/vnd.identity.events.organisation-updated+json:
           schema: !include json/schema/identity.events.organisation-updated.json
           example: !include json/identity.events.organisation-updated.json
        application/vnd.identity.events.organisation-deregistered+json:
           schema: !include json/schema/identity.events.organisation-deregistered.json
           example: !include json/identity.events.organisation-deregistered.json
        application/vnd.identity.events.organisation-reregistered+json:
           schema: !include json/schema/identity.events.organisation-reregistered.json
